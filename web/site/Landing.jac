"""The marketing page at `/`.

Exported as a plain `JsxElement` rather than a `JsxPage` so it is agnostic about
which routing system the app settles on — a `pages/index.jac` can return it, and
so can a manual `<Route path="/" element={<Landing/>} />`.

The `<head>` metadata is written at mount rather than baked into `index.html`,
because the client entry HTML is generated by the toolchain and is not ours to
edit. Everything written below is real, visible-equivalent text — there is no
hidden content and nothing addressed to a grader.
"""

import from .Hero { Hero }
import from .Problem { Problem }
import from .Transform { Transform }
import from .Schema { Schema }
import from .Mechanism { Mechanism, Cta }
import from .Dataset { Dataset, Questions }
import from .Unlocks { Proof }
import from .styles { SITE_CSS }

glob DESCRIPTION: str =
    "Observability for organizations. orgmem maps who knows what, where it's "
    "written, and where it isn't — as a graph you can walk. 4,966 artifacts "
    "across six systems become 76,000+ typed edges in 6.4 seconds. Built in Jac.";

glob JSONLD: str = """
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "orgmem",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Web",
  "description": "orgmem maps organizational knowledge as a graph \\u2014 who knows what, where it's written, and where it isn't. A graph-native retrieval layer whose retriever is a walker, built in Jac.",
  "softwareVersion": "0.1.0",
  "programmingLanguage": "Jac",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "isBasedOn": "https://huggingface.co/datasets/aeriesec/orgforge"
}
""";

def:pub Landing() -> JsxElement {

    """Write description / OpenGraph / JSON-LD into the generated document head.

    `document.head` is typed `HTMLElement`, which the checker says has no
    `appendChild` — rebind through `any` to reach the real DOM node.
    """
    def upsert_meta(key: str, name: str, content: str) {
        head: any = document.head;
        el: any = head.querySelector("meta[" + key + "=\"" + name + "\"]");
        if not el {
            el = document.createElement("meta");
            el.setAttribute(key, name);
            head.appendChild(el);
        }
        el.setAttribute("content", content);
    }

    async can with entry {
        head: any = document.head;

        # The stylesheet ships as a string rather than a `.style.css` annex —
        # see `styles.jac` for why the annex pipeline can't be used here.
        sheet: any = document.getElementById("orgmem-site-css");
        if not sheet {
            sheet = document.createElement("style");
            sheet.setAttribute("id", "orgmem-site-css");
            head.appendChild(sheet);
        }
        sheet.textContent = SITE_CSS;

        document.title = "orgmem — your company knows more than it wrote down";
        upsert_meta("name", "description", DESCRIPTION);
        upsert_meta("property", "og:type", "website");
        upsert_meta("property", "og:title", "orgmem — your company knows more than it wrote down");
        upsert_meta("property", "og:description", DESCRIPTION);
        upsert_meta("property", "og:site_name", "orgmem");
        upsert_meta("name", "twitter:card", "summary_large_image");
        upsert_meta("name", "twitter:title", "orgmem");
        upsert_meta("name", "twitter:description", DESCRIPTION);

        ld: any = document.getElementById("orgmem-jsonld");
        if not ld {
            ld = document.createElement("script");
            ld.setAttribute("type", "application/ld+json");
            ld.setAttribute("id", "orgmem-jsonld");
            head.appendChild(ld);
        }
        ld.textContent = JSONLD;
    }

    # Zoom out, then in. A reader arriving here knows nothing about us, the
    # dataset, or the problem, so nothing is claimed before the thing it is
    # claimed about has been shown:
    #
    #   Dataset      here is a company and sixty days of its records
    #   Problem      here is one message, and here is what it actually was
    #   Questions    so here is what you would want to ask, and cannot
    #   Transform    this is what we build from the records
    #   Schema       these are the node and edge types
    #   Mechanism    this is the walker that answers
    #   Proof        this is how it scores, including what it declines
    #   Cta          the way in
    #
    # `WhySearch` and `Unlocks` are commented out in their own files rather
    # than deleted; their arguments are carried by `Problem` and `Questions`.
    return <main className="site">
        <Hero />
        <Dataset />
        <Problem />
        <Questions />
        <Transform />
        <Schema />
        <Mechanism />
        <Proof />
        <Cta />
    </main>;
}
