"""The card shell: window frame, accent bar, dispatch, and the shared footer.

Everything under `card/` imports this and nothing else imports sideways, so the
six per-kind components can be written in parallel without colliding. If you are
writing one of those six: **do not edit this file.** Add nothing to it. The
tokens and helpers below are the whole shared surface.

Three decisions worth knowing before you build on it.

**The accent bar is the product, not the trim.** A 3px strip in that kind's
`TYPE_COLOR` runs across the top of every card, and it is the same colour as the
dot on the graph canvas that opened it. That tie is the one thing the judge is
meant to notice without being told, which is why the colours are duplicated here
rather than imported from `GraphCanvas` — the card set must build and be
reviewed with the graph nowhere in the picture.

**Positioning is CSS, not JavaScript.** The window is anchored at the click
point and must never leave the viewport, and the obvious way to do that —
reading `window.innerWidth` in a layout effect — is both a re-render on resize
and a client-only global this compiler is not guaranteed to hand you. CSS
`clamp(8px, <x>px, calc(100vw - 436px))` does the whole job in the style dict,
with no measurement, no effect, and no globals. `clamp` resolves to its minimum
when the bounds cross, so a viewport narrower than the card degrades to a
flush-left window instead of a broken one.

**`docked` exists for the gallery.** Floating is the real mode: fixed position,
a click-catching backdrop, a close ×. Docked drops all three and renders in
normal document flow, so `Gallery.jac` can show every fixture at once instead of
twenty-eight windows stacked on the same pixel. Nothing about the card's
interior changes between the two.

Close is × / Escape / click-outside. Escape is a keydown handler on the card
itself with an autofocus effect rather than a `document` listener — same reason
as the clamp: it keeps the shell free of browser globals, and the backdrop
already catches everything outside.
"""

import from react { useEffect }
import from .SlackCard { SlackCard }
import from .ZoomCard { ZoomCard }
import from .EmailCard { EmailCard }
import from .ConfluenceCard { ConfluenceCard }
import from .TicketCard { TicketCard }
import from .EntityCard { EntityCard }

# EVERY global in this file is `cl`, exported or not. `cl` for the same reason
# the helpers below carry it: an access-tagged global
# is skipped by the compiler's client pull and stays server-side, and a client
# function that reads it fails at runtime with a bare `TYPE_COLOR is not
# defined` — after the module has loaded, so the page renders blank rather than
# erroring at import. `glob:pub` is still required for the export itself
# (CARD-CONTRACT §3); `cl glob:pub` is the combination that is both exported
# and present in the browser.
#
# Node colours, copied from web/GraphCanvas.jac. The last two are new: the graph
# predates SFOpportunity and ZDTicket having their own dots. Both hues were
# chosen for separation from the ten that already existed — a teal at ~165° and
# an indigo at ~234°, the two widest gaps left on the wheel.
cl glob:pub TYPE_COLOR: dict[str, str] = {
    "Person": "#5ec8f8",
    "Department": "#c792ea",
    "Domain": "#8bd450",
    "Event": "#ff7b72",
    "ConfluencePage": "#f7c948",
    "SlackThread": "#f79ac0",
    "Email": "#ffa657",
    "JiraTicket": "#79c0ff",
    "ZoomTranscript": "#a5d6ff",
    "PullRequest": "#d2a8ff",
    "SFOpportunity": "#39d3a7",
    "ZDTicket": "#8f9bff"
};

cl glob:pub CARD_BG: str    = "#11151d";
cl glob:pub CARD_PANE: str  = "#161b24";   # inset regions: message rows, table headers
cl glob:pub CARD_FG: str    = "#e6edf3";
cl glob:pub CARD_MUTED: str = "#8b98a9";
cl glob:pub CARD_LINE: str  = "rgba(150,170,200,0.16)";
cl glob:pub CARD_SANS: str  = "system-ui, -apple-system, sans-serif";
cl glob:pub CARD_MONO: str  = "ui-monospace, SFMono-Regular, Menlo, monospace";

cl glob:pub CARD_W: int = 420;
cl glob:pub CARD_MAX_H: int = 520;

# Avatar hues. Solid fill with dark text, the way Slack does it — a tinted
# translucent chip loses too much at three metres.
cl glob AVATARS: list[str] = [
    "#f2a3b3", "#7fc8f0", "#9ad97f", "#f0c674",
    "#c9a0f0", "#7fd8cd", "#f0a06a", "#a8b4f0"
];

cl glob ALPHABET: str = "abcdefghijklmnopqrstuvwxyz0123456789";

cl glob MONTHS: list[str] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                          "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

# 2026 is not a leap year; the corpus ends on day 60, in March.
cl glob MONTH_LEN: list[int] = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];

# The day the walkers treat as "now". `time_ago` is relative to it.
cl glob:pub TODAY: int = 60;

cl glob KNOWN_KINDS: list[str] = [
    "SlackThread", "ZoomTranscript", "Email", "ConfluencePage",
    "JiraTicket", "PullRequest", "SFOpportunity", "ZDTicket",
    "Person", "Domain", "Event", "Department"
];


# ------------------------------------------------------------------ helpers
#
# `cl` on every one of these is load-bearing, not decoration. A `def:pub` with
# no JSX in its body is inferred into the SERVER codespace — access-tagged
# declarations are explicitly skipped by the compiler's client pull — and the
# call sites below it are then rewritten into `POST /function/<name>`. The page
# still renders and `jac check` still passes; it just makes one HTTP round trip
# per initial, per date, per avatar colour. Twenty-eight cards produced enough
# traffic that the page never reached network idle.
#
# Anything in `card/` that does not itself return JsxElement needs `cl`.

cl def:pub accent_for(kind: str) -> str {
    return (TYPE_COLOR[kind] as str) if kind in TYPE_COLOR else "#8899bb";
}

# "Nora Klein" -> "NK", "Jax" -> "JX". Two letters always: a one-letter avatar
# reads as a bullet point at a distance.
cl def:pub initials(name: str) -> str {
    s: str = name.strip();
    if s == "" {
        return "??";
    }
    parts: list[str] = [p for p in s.split(" ") if p != ""];
    if len(parts) >= 2 {
        return (parts[0][0] + parts[1][0]).upper();
    }
    if len(parts[0]) >= 2 {
        return parts[0][:2].upper();
    }
    return (parts[0] + parts[0]).upper();
}

# Stable across renders and across cards: the same person is the same colour in
# a Slack thread, a Zoom transcript and a footer chip.
#
# The character's ordinal comes out of a `split`, not `ALPHABET.find(ch)` and
# not `ord`. `jac check` warns W6002 on `.find` — it reads as `Array.find`,
# which is a different function on the client target — and `ord` is a Python
# builtin with no guaranteed JS lowering. `split` exists identically on both
# sides, and an unlisted character (a space, a hyphen) lands on len(ALPHABET),
# which is a value like any other here.
cl def:pub avatar_color(name: str) -> str {
    h: int = len(name);
    for ch in name.lower() {
        h = (h * 31 + len(ALPHABET.split(ch)[0]) + 1) % 100003;
    }
    return AVATARS[h % len(AVATARS)];
}

# Day 1 is 2026-01-01, and days advance by BUSINESS day, not calendar day —
# that is how `main.jac` recovers the 0-sentinel dates at ingest, so day 43 is
# 2 March, not 12 February. Getting this wrong puts a date on the card that
# contradicts the timestamp inside the artifact's own id.
cl def:pub day_date(day: int) -> str {
    if day <= 0 {
        return "";
    }
    y: int = 2026;
    m: int = 1;
    d: int = 1;
    dow: int = 3;               # 2026-01-01 was a Thursday; 0 = Monday
    left: int = day - 1;
    while left > 0 {
        d += 1;
        dow = (dow + 1) % 7;
        if d > MONTH_LEN[m - 1] {
            d = 1;
            m += 1;
        }
        if m > 12 {
            m = 1;
            y += 1;
        }
        if dow < 5 {
            left -= 1;
        }
    }
    return MONTHS[m - 1] + " " + str(d) + ", " + str(y);
}

cl def:pub time_ago(day: int) -> str {
    if day <= 0 {
        return "";
    }
    gap: int = TODAY - day;
    if gap <= 0 {
        return "today";
    }
    if gap == 1 {
        return "yesterday";
    }
    return str(gap) + " days ago";
}


# ------------------------------------------------------------------ footer

def:pub Avatar(name: str, size: int = 22) -> JsxElement {
    return <span title={name}
                 style={{"display": "inline-flex", "alignItems": "center",
                         "justifyContent": "center", "flexShrink": "0",
                         "width": str(size) + "px", "height": str(size) + "px",
                         "borderRadius": "50%", "background": avatar_color(name),
                         "color": "#0b0e14", "fontFamily": CARD_SANS,
                         "fontSize": str(size // 2) + "px", "fontWeight": "700",
                         "letterSpacing": "0.02em"}}>
        {initials(name)}
    </span>;
}

def:pub Chip(text: str) -> JsxElement {
    return <span style={{"display": "inline-block", "padding": "2px 7px",
                         "borderRadius": "4px", "border": "1px solid " + CARD_LINE,
                         "background": CARD_PANE, "color": CARD_MUTED,
                         "fontFamily": CARD_MONO, "fontSize": "10.5px",
                         "lineHeight": "1.5", "whiteSpace": "nowrap"}}>
        {text}
    </span>;
}

def RefRow(gid: str, kind: str, title: str, onOpenRef: any = None) -> JsxElement {
    def handle(e: MouseEvent) {
        if onOpenRef {
            onOpenRef(gid);
        }
    }
    return <div onClick={handle}
                style={{"display": "flex", "alignItems": "center", "gap": "7px",
                        "padding": "4px 0", "cursor": "pointer" if onOpenRef else "default"}}>
        <span style={{"width": "7px", "height": "7px", "borderRadius": "50%",
                      "flexShrink": "0", "background": accent_for(kind)}} />
        <span style={{"flex": "1", "minWidth": "0", "overflow": "hidden",
                      "textOverflow": "ellipsis", "whiteSpace": "nowrap",
                      "fontFamily": CARD_SANS, "fontSize": "11.5px",
                      "color": CARD_FG}}>{title if title != "" else gid}</span>
        <span style={{"flexShrink": "0", "fontFamily": CARD_MONO,
                      "fontSize": "10px", "color": CARD_MUTED}}>{kind}</span>
    </div>;
}

# Rendered by the shell for every kind, so it is identical everywhere. Each
# section disappears when its list is empty — most artifacts reference nothing,
# and a row of empty labels is worse than no row.
def Footer(c: dict[str, any], onOpenRef: any = None) -> JsxElement {
    authors: list = (c["authors"] as list) if c["authors"] else [];
    domains: list = (c["domains"] as list) if c["domains"] else [];
    refs: list = (c["refs"] as list) if c["refs"] else [];
    day: int = (c["day"] as int) if c["day"] else 0;
    gid: str = (c["gid"] as str) if c["gid"] else "";
    dept: str = (c["dept"] as str) if c["dept"] else "";

    stamp: str = day_date(day);
    if stamp != "" {
        stamp = stamp + " · " + time_ago(day);
    }
    if dept != "" {
        stamp = (stamp + " · " + dept) if stamp != "" else dept;
    }

    return <div style={{"flexShrink": "0", "borderTop": "1px solid " + CARD_LINE,
                        "background": CARD_PANE, "padding": "9px 14px 10px 14px"}}>
        {if len(authors) > 0 {
            <div key="authors"
                 style={{"display": "flex", "flexWrap": "wrap", "gap": "10px",
                         "alignItems": "center", "marginBottom": "8px"}}>
                {for a in authors[:6] {
                    <span key={a as str}
                          style={{"display": "inline-flex", "alignItems": "center",
                                  "gap": "5px"}}>
                        <Avatar name={a as str} size={20} />
                        <span style={{"fontFamily": CARD_SANS, "fontSize": "11.5px",
                                      "color": CARD_FG}}>{a}</span>
                    </span>
                }}
                {if len(authors) > 6 {
                    <span key="more"
                          style={{"fontFamily": CARD_MONO, "fontSize": "11px",
                                  "color": CARD_MUTED}}>
                        {"+" + str(len(authors) - 6)}
                    </span>
                }}
            </div>
        }}

        {if len(domains) > 0 {
            <div key="domains"
                 style={{"display": "flex", "flexWrap": "wrap", "gap": "5px",
                         "marginBottom": "8px"}}>
                {for d in domains {
                    <Chip key={d as str} text={d as str} />
                }}
            </div>
        }}

        {if len(refs) > 0 {
            <div key="refs" style={{"marginBottom": "6px"}}>
                <div style={{"fontFamily": CARD_MONO, "fontSize": "9.5px",
                             "letterSpacing": "0.14em", "color": CARD_MUTED,
                             "marginBottom": "2px"}}>
                    {"REFERENCES · " + str(len(refs))}
                </div>
                {for r in refs {
                    <RefRow key={r["gid"] as str} gid={r["gid"] as str}
                            kind={r["kind"] as str} title={r["title"] as str}
                            onOpenRef={onOpenRef} />
                }}
            </div>
        }}

        <div style={{"display": "flex", "gap": "10px", "alignItems": "baseline",
                     "fontFamily": CARD_MONO, "fontSize": "10px",
                     "color": CARD_MUTED}}>
            <span style={{"flex": "1", "minWidth": "0", "overflow": "hidden",
                          "textOverflow": "ellipsis", "whiteSpace": "nowrap"}}>{gid}</span>
            <span style={{"flexShrink": "0"}}>{stamp}</span>
        </div>
    </div>;
}


# ------------------------------------------------------------------ fallback

def Fallback(c: dict[str, any]) -> JsxElement {
    title: str = (c["title"] as str) if c["title"] else "";
    body: str = (c["body"] as str) if c["body"] else "";
    return <div style={{"padding": "14px"}}>
        <div style={{"fontFamily": CARD_MONO, "fontSize": "10px",
                     "letterSpacing": "0.14em", "color": CARD_MUTED}}>
            {"UNKNOWN KIND · " + ((c["kind"] as str) if c["kind"] else "?")}
        </div>
        <div style={{"fontFamily": CARD_SANS, "fontSize": "15px",
                     "fontWeight": "600", "color": CARD_FG, "margin": "4px 0 10px 0"}}>
            {title if title != "" else "(untitled)"}
        </div>
        <pre style={{"margin": "0", "fontFamily": CARD_MONO, "fontSize": "11.5px",
                     "lineHeight": "1.55", "color": CARD_MUTED,
                     "whiteSpace": "pre-wrap", "wordBreak": "break-word"}}>
            {body if body != "" else "(no body)"}
        </pre>
    </div>;
}


# ------------------------------------------------------------------ the card

def:pub Card(payload: dict[str, any], x: float = 0.0, y: float = 0.0,
             onClose: any = None, docked: bool = False,
             onOpenRef: any = None) -> JsxElement {
    has boxRef: Ref[HTMLDivElement] = Ref();

    # Nothing from the server is dotted into unguarded. `node_card` promises the
    # keys are present, not that they are filled, and one bad subscript takes
    # down the page rather than the card.
    c: dict[str, any] = payload if payload else {};
    kind: str = (c["kind"] as str) if c["kind"] else "";
    accent: str = accent_for(kind);
    known: bool = kind in KNOWN_KINDS;

    def close {
        if onClose {
            onClose();
        }
    }

    def handle_close(e: MouseEvent) {
        e.stopPropagation();
        close();
    }

    def handle_backdrop(e: MouseEvent) {
        close();
    }

    def handle_key(e: KeyboardEvent) {
        if e.key == "Escape" {
            close();
        }
    }

    # Focus the window on mount so Escape reaches it without a document-level
    # listener. Harmless when docked; the gallery just gets a focusable div.
    useEffect(lambda {
        if boxRef.current and not docked {
            boxRef.current.focus();
        }
        return lambda {  };
    }, []);

    shell: dict[str, str] = {
        "width": str(CARD_W) + "px",
        "maxHeight": str(CARD_MAX_H) + "px",
        "display": "flex",
        "flexDirection": "column",
        "overflow": "hidden",
        "boxSizing": "border-box",
        "background": CARD_BG,
        "color": CARD_FG,
        "fontFamily": CARD_SANS,
        "border": "1px solid " + CARD_LINE,
        "borderRadius": "10px",
        "outline": "none"
    };
    if docked {
        shell["position"] = "relative";
        shell["width"] = "100%";
    } else {
        shell["position"] = "fixed";
        shell["zIndex"] = "61";
        # The whole viewport-clamping story, in two style properties.
        shell["left"] = "clamp(8px, " + str(int(x)) + "px, calc(100vw - " + str(CARD_W + 16) + "px))";
        shell["top"] = "clamp(8px, " + str(int(y)) + "px, calc(100vh - " + str(CARD_MAX_H + 20) + "px))";
        shell["boxShadow"] = "0 18px 48px rgba(0,0,0,0.55), 0 2px 6px rgba(0,0,0,0.4)";
    }

    return <>
        {if not docked {
            <div key="backdrop" onClick={handle_backdrop}
                 style={{"position": "fixed", "top": "0", "left": "0",
                         "right": "0", "bottom": "0", "zIndex": "60"}} />
        }}
        <div ref={boxRef} tabIndex={-1} onKeyDown={handle_key} style={shell}>
            <div style={{"height": "3px", "flexShrink": "0", "background": accent}} />

            {if not docked {
                <button key="close" onClick={handle_close} aria-label="Close"
                        style={{"position": "absolute", "top": "9px", "right": "9px",
                                "zIndex": "2", "width": "22px", "height": "22px",
                                "display": "flex", "alignItems": "center",
                                "justifyContent": "center", "padding": "0",
                                "background": "transparent", "cursor": "pointer",
                                "border": "1px solid transparent", "borderRadius": "5px",
                                "color": CARD_MUTED, "fontSize": "15px",
                                "lineHeight": "1", "fontFamily": CARD_SANS}}>
                    {"×"}
                </button>
            }}

            <div style={{"flex": "1", "minHeight": "0", "overflowY": "auto",
                         "overflowX": "hidden"}}>
                {if kind == "SlackThread" { <SlackCard key="body" c={c} /> }}
                {if kind == "ZoomTranscript" { <ZoomCard key="body" c={c} /> }}
                {if kind == "Email" { <EmailCard key="body" c={c} /> }}
                {if kind == "ConfluencePage" { <ConfluenceCard key="body" c={c} /> }}
                {if kind in ["JiraTicket", "PullRequest", "SFOpportunity", "ZDTicket"] {
                    <TicketCard key="body" c={c} />
                }}
                {if kind in ["Person", "Domain", "Event", "Department"] {
                    <EntityCard key="body" c={c} />
                }}
                {if not known { <Fallback key="body" c={c} /> }}
            </div>

            <Footer c={c} onOpenRef={onOpenRef} />
        </div>
    </>;
}
